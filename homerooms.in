#!@SHELL@
# Copyright (C) 2011-2015 Richard "RichiH" Hartmann <richih@debian.org>, see CONTRIBUTORS for details.
# SPDX-License-Identifier: GPL-2.0-or-later
#
# While the following is not legally binding, the author would like to explain
# the choice of GPLv2+ over GPLv3+. The author prefers GPLv3+ over GPLv2+ but
# feels it's better to maintain full compatibility's with Git. In case Git ever
# changes its licensing terms, which is admittedly extremely unlikely to the
# point of being impossible, this software will most likely follow suit.

# This should always be the first line of code to facilitate debugging
[ -n "$HOMEROOMS_DEBUG" ] && set -vx

# If '.r<N>-g<SHA>' is appended to the version, you are seeing an unreleased
# version built from the main branch HEAD. If "-standalone" is appended you are
# using a version built explicitly for portability as a standalone script
# rather than being installed to a specific system.
HOMEROOMS_VERSION='@VERSION@@DEPLOYMENT@'; export HOMEROOMS_VERSION
HOMEROOMS_SELF='room'; export HOMEROOMS_SELF

# Ensure all files created are accessible only to the current user.
umask 0077

fatal() {
	echo "$HOMEROOMS_SELF: fatal: $1" >&2
	[ -z "$2" ] && exit 1
	exit "$2"
}

# We need to run getops as soon as possible so we catch -d and other
# options that will modify our behaviour.
# Commands are handled at the end of this script.
# shellcheck disable=SC2220
while getopts c:dv flag; do
	case "$flag" in
		d)
			set -vx
			HOMEROOMS_DEBUG=1
			export HOMEROOMS_DEBUG
			echo 'debug mode on'
			echo "$HOMEROOMS_SELF $HOMEROOMS_VERSION"
			;;
		v)
			HOMEROOMS_VERBOSE=1
			export HOMEROOMS_VERBOSE
			echo 'verbose mode on'
			echo "$HOMEROOMS_SELF $HOMEROOMS_VERSION"
			;;
		c)
			HOMEROOMS_OPTION_CONFIG="$OPTARG"
			export HOMEROOMS_OPTION_CONFIG
			;;
	esac
done
shift $((OPTIND-1))

source_all() {
	# Source file even if it's in $PWD and does not have any slashes in it
	# shellcheck source=/dev/null
	case "$1" in
		*/*) . "$1";;
		*)   . "$PWD/$1";;
	esac;
}


# Read configuration and set defaults if anything's not set
[ -n "$HOMEROOMS_DEBUG" ]                  && set -vx
: "${XDG_CONFIG_HOME:="$HOME/.config"}"

# Read configuration files if there are any
# shellcheck source=/dev/null
[ -r "/etc/house/config" ]             && . "/etc/house/config"
# shellcheck source=/dev/null
[ -r "$XDG_CONFIG_HOME/house/config" ] && . "$XDG_CONFIG_HOME/house/config"
if [ -n "$HOMEROOMS_OPTION_CONFIG" ]; then
	# Source $HOMEROOMS_OPTION_CONFIG if it can be read and is in $PWD of $PATH
	if [ -r "$HOMEROOMS_OPTION_CONFIG" ]; then
		source_all "$HOMEROOMS_OPTION_CONFIG"
	else
		fatal "Can not read configuration file '$HOMEROOMS_OPTION_CONFIG'" 1
	fi
fi
[ -n "$HOMEROOMS_DEBUG" ]                  && set -vx

# Read defaults
: "${HOMEROOMS_REPO_D:="$XDG_CONFIG_HOME/house/rooms"}"; export HOMEROOMS_REPO_D
: "${HOMEROOMS_HOOK_D:="$XDG_CONFIG_HOME/house/hooks-enabled"}"; export HOMEROOMS_HOOK_D
: "${HOMEROOMS_OVERLAY_D:="$XDG_CONFIG_HOME/house/overlays-enabled"}"; export HOMEROOMS_OVERLAY_D
: "${HOMEROOMS_MANIFEST:="$XDG_CONFIG_HOME/house/rooms.list"}"; export HOMEROOMS_MANIFEST
: "${HOMEROOMS_BASE:="$HOME"}"; export HOMEROOMS_BASE
: "${HOMEROOMS_GITIGNORE:=exact}"; export HOMEROOMS_GITIGNORE
: "${HOMEROOMS_GITATTRIBUTES:=none}"; export HOMEROOMS_GITATTRIBUTES
: "${HOMEROOMS_WORKTREE:=absolute}"; export HOMEROOMS_WORKTREE

if [ ! "x$HOMEROOMS_GITIGNORE" = 'xexact' ] && [ ! "x$HOMEROOMS_GITIGNORE" = 'xnone' ] && [ ! "x$HOMEROOMS_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$HOMEROOMS_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

if [ ! "x$HOMEROOMS_WORKTREE" = 'xabsolute' ] && [ ! "x$HOMEROOMS_WORKTREE" = 'xrelative' ]; then
	fatal "'\$HOMEROOMS_WORKTREE' must equal 'absolute', or 'relative'" 1
fi


# editorconfig-checker-disable
help() {
	echo "usage: $HOMEROOMS_SELF <options> <command>

   options:
   -c <file>            Source file
   -d                   Enable debug mode
   -v                   Enable verbose mode

   commands:
   clone [-b <branch>] \\
         <remote> \\
         [<repo>]       Clone from an existing repository
   commit               Commit in all repositories
   delete <repo>        Delete an existing repository
   enter <repo>         Enter repository; spawn new instance of \$SHELL
                        with \$GIT_DIR set.
   foreach \\
     [<-g>] [<-p>] \\
     <git command>      Execute a command for every repository
   help                 Display this help text
   init <repo>          Initialize a new repository
   list                 List all repositories
   list-tracked \\
        [<repo>]        List all files tracked all or one repositories
   list-untracked \\
        [<-a>] [<-r>]
        [<repo>]        List all files not tracked by all or one repositories
   manifest [<file>]    Write repo list (name/url/branch) to <file> or
                        \$HOMEROOMS_MANIFEST; use '-' for stdout
   pull                 Pull from all room remotes
   push                 Push to room remotes
   restore [<file>]     Clone every repo listed in a manifest file
   rename <repo> \\
          <newname>     Rename repository
   run <repo> \\
       <command>        Use this repository
   status \\
     [--terse] [<repo>] Show statuses of all/one room repositories
   upgrade <repo>       Upgrade repository to currently recommended settings
   version              Print version information
   which <substring>    Find substring in name of any tracked file
   write-gitignore \\
   [<repo>]             Write .gitignore.d/<repo> via git ls-files

   <repo> <git command> Shortcut to run git commands directly
   <repo>               Shortcut to enter repository" >&2
}
# editorconfig-checker-enable

debug() {
	if [ -n "$HOMEROOMS_DEBUG" ]; then echo "$HOMEROOMS_SELF: debug: $*"; fi
}

verbose() {
	if [ -n "$HOMEROOMS_DEBUG" ] || [ -n "$HOMEROOMS_VERBOSE" ]; then
		echo "$HOMEROOMS_SELF: verbose: $*"
	fi
}

error() {
	echo "$HOMEROOMS_SELF: error: $1" >&2
}

info() {
	echo "$HOMEROOMS_SELF: info: $1"
}

clone() {
	hook pre-clone
	# Check if remote is reachable. Abort early if there's a typo, TLS certificate problem, etc
	@GIT@ ls-remote "$GIT_REMOTE" 2> /dev/null || fatal "Can not reach '$GIT_REMOTE'"
	init
	# Test which, if any, given or detected branches can be pulled from.
	# In a future version, if we need the logic, we could do the following:
	#   git ls-remote ORIGIN
	#   get HEAD commit ID
	#   see what refs/heads/* match that commit ID
	#   set HOMEROOMS_BRANCH if only one match
	#   offer a list of all matching refs for the user to choose
	for HOMEROOMS_BRANCH_TEST in "$HOMEROOMS_BRANCH" master trunk development; do
		if [ $(@GIT@ ls-remote "$GIT_REMOTE" "$HOMEROOMS_BRANCH_TEST" 2> /dev/null | @WC@ -l ) -lt 1 ]; then
			info "remote branch '$HOMEROOMS_BRANCH_TEST' empty"
		else
			info "remote branch '$HOMEROOMS_BRANCH_TEST' found"
			HOMEROOMS_BRANCH_REMOTE=$HOMEROOMS_BRANCH_TEST
			break
		fi
	done
	if [ -z "$HOMEROOMS_BRANCH_REMOTE" ]; then
		info "No non-empty remote branches found, aborting. Please run `$0 delete $HOMEROOMS_REPO_NAME`, determine the correct branch, and try again."
		exit
	fi
	HOMEROOMS_BRANCH=$HOMEROOMS_BRANCH_REMOTE

	# Set up remote
	@GIT@ remote add origin "$GIT_REMOTE"
	@GIT@ checkout -b "$HOMEROOMS_BRANCH" || return $?
	@GIT@ config branch."$HOMEROOMS_BRANCH".remote origin
	@GIT@ config branch."$HOMEROOMS_BRANCH".merge  refs/heads/"$HOMEROOMS_BRANCH"
	GIT_VERSION_MAJOR=$(@GIT@ --version | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p' )
	if [ 1 -lt "$GIT_VERSION_MAJOR" ];then
		@GIT@ fetch origin "$HOMEROOMS_BRANCH"
	else
		@GIT@ fetch origin
	fi
	hook pre-merge
	@GIT@ read-tree -n -mu origin/"$HOMEROOMS_BRANCH" \
		|| fatal "will stop after fetching and not try to merge!
  Once this situation has been resolved, run 'room $HOMEROOMS_REPO_NAME pull' to finish cloning." 17 # editorconfig-checker-disable-line
	@GIT@ -c merge.ff=true merge origin/"$HOMEROOMS_BRANCH"
	hook post-merge
	hook post-clone
	retire
	hook post-clone-retired
}

commit() {
	hook_global pre-commit
	shift  # remove the "commit" command.
	for HOMEROOMS_REPO_NAME in $(list); do
		export HOMEROOMS_REPO_NAME
		echo "$HOMEROOMS_REPO_NAME: "
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-commit
		@GIT@ commit --untracked-files=no --quiet "$@"
		hook_repo post-commit
		HOMEROOMS_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-commit
}

delete() {
	cd "$HOMEROOMS_BASE" || fatal "could not enter '$HOMEROOMS_BASE'" 11
	use
	info "This operation WILL DESTROY DATA!"
	files=$(@GIT@ ls-files)
	echo "These files will be deleted:

$files

AGAIN, THIS WILL DELETE YOUR DATA!
To continue, type 'Yes, do as I say'"
	read -r answer
	[ "x$answer" = 'xYes, do as I say' ] || exit 16
	# Use -z/-0 so that paths containing whitespace, shell globbing
	# characters, or non-ASCII bytes (which `git ls-files` would otherwise
	# C-quote) are handled verbatim; `--` guards against leading dashes.
	@GIT@ ls-files -z | xargs -0 rm -f -- ||
		info "could not delete some files, continuing with repository deletion"
	rm -rf "$GIT_DIR" || error "could not delete '$GIT_DIR'"
	rm -f "$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.room"
}

enter() {
	hook pre-enter
	use
	$SHELL
	hook post-enter
}

foreach() {
	hook_global pre-foreach

	# We default to prefixing `git` to all commands passed to foreach, but
	# allow running in general context with -g
	command_prefix=@GIT@
	# shellcheck disable=SC2220
	while getopts gp flag; do
		case "$flag" in
			g) unset command_prefix ;;
			p) HOMEROOMS_PRINT_REPO_PREFIX=1 ;;
		esac
	done
	shift $((OPTIND-1))
	export HOMEROOMS_PRINT_REPO_PREFIX
	for HOMEROOMS_REPO_NAME in $(list); do
		export HOMEROOMS_REPO_NAME
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-foreach
		if [ -n "${HOMEROOMS_PRINT_REPO_PREFIX+x}" ]; then
			$command_prefix "$@" | @SED@ "s/^/$HOMEROOMS_REPO_NAME: /"
		else
			echo "$HOMEROOMS_REPO_NAME:"
			$command_prefix "$@"
		fi
		hook_repo post-foreach
	done
	hook_global post-foreach
}

git_dir_exists() {
	[ -d "$GIT_DIR" ] || fatal "no repository found for '$HOMEROOMS_REPO_NAME'" 12
}

hook_global() {
	for hook in "$HOMEROOMS_HOOK_D/$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook"
	done
}

hook_repo() {
	for hook in "$HOMEROOMS_HOOK_D/$HOMEROOMS_REPO_NAME.$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook" || fatal "hook [$hook] failed" 1
	done
}

hook() {
	hook_global "$1"
	hook_repo "$1"
}

init() {
	hook pre-init
	[ ! -e "$GIT_DIR" ] || fatal "'$GIT_DIR' exists" 10
	mkdir -p "$HOMEROOMS_BASE" || fatal "could not create '$HOMEROOMS_BASE'" 50
	cd "$HOMEROOMS_BASE" || fatal "could not enter '$HOMEROOMS_BASE'" 11
	@GIT@ init --shared=false
	upgrade
	hook post-init
}

list() {
	for repo in "$HOMEROOMS_REPO_D"/*.git; do
		[ -d "$repo" ] && [ -r "$repo" ] && basename "$repo" .git
	done
}

list_has_remote() {
	for HOMEROOMS_REPO_NAME in $(list); do
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
		# This command returns the tracking branch of the currently-checked-out local
		# branch, if any. See https://stackoverflow.com/a/9753364
		[ -n  "$(@GIT@ for-each-ref "$(@GIT@ symbolic-ref -q HEAD)")" ] && echo "$HOMEROOMS_REPO_NAME"
	done
}

manifest() {
	# Write "<name>\t<remote-url>\t<branch>" for every repo that has an
	# 'origin' remote. Target: $2, else $HOMEROOMS_MANIFEST; '-' means stdout.
	target=${2:-$HOMEROOMS_MANIFEST}
	if [ "x$target" != 'x-' ]; then
		{
			echo "# $HOMEROOMS_SELF manifest -- fields: <name> <tab> <remote-url> <tab> <branch>"
			echo "# regenerate with: $HOMEROOMS_SELF manifest"
		} > "$target" || fatal "could not write '$target'" 50
	fi
	for HOMEROOMS_REPO_NAME in $(list); do
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR HOMEROOMS_REPO_NAME
		url=$(@GIT@ config --get remote.origin.url) || continue
		[ -n "$url" ] || continue
		branch=$(@GIT@ symbolic-ref --quiet --short HEAD 2> /dev/null) || branch=
		if [ "x$target" = 'x-' ]; then
			printf '%s\t%s\t%s\n' "$HOMEROOMS_REPO_NAME" "$url" "$branch"
		else
			printf '%s\t%s\t%s\n' "$HOMEROOMS_REPO_NAME" "$url" "$branch" >> "$target"
		fi
	done
	[ "x$target" = 'x-' ] || info "wrote manifest to '$target'"
}

restore() {
	# Clone every repo listed in a manifest file that is not already present.
	source_file=${2:-$HOMEROOMS_MANIFEST}
	[ -r "$source_file" ] || fatal "$HOMEROOMS_COMMAND: manifest not readable: '$source_file'" 1
	tab=$(printf '\t')
	while IFS="$tab" read -r name url branch; do
		case "$name" in ''|\#*) continue;; esac
		if [ -z "$url" ]; then
			info "skipping '$name': no URL in manifest"
			continue
		fi
		if [ -e "$HOMEROOMS_REPO_D/$name.git" ]; then
			info "skipping '$name': already present"
			continue
		fi
		info "cloning '$name' from '$url'"
		if [ -n "$branch" ]; then
			"$0" clone -b "$branch" "$url" "$name" || error "failed to clone '$name'"
		else
			"$0" clone "$url" "$name" || error "failed to clone '$name'"
		fi
	done < "$source_file"
}

get_files() {
	GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
	@GIT@ ls-files --full-name
}

list_tracked() {
	HOMEROOMS_REPO_NAME=$2; export HOMEROOMS_REPO_NAME
	if [ -n "$HOMEROOMS_REPO_NAME" ]; then
		get_files | list_tracked_helper
	else
		for HOMEROOMS_REPO_NAME in $(list); do
			get_files
		done | list_tracked_helper
	fi
}

list_tracked_helper() {
	@SED@ "s,^,$(printf '%s\n' "$HOMEROOMS_BASE/" | @SED@ 's/[,\&]/\\&/g')," | sort -u
}

list_tracked_by() {
	list_tracked '' "$2"
}

list_untracked() {
	temp_file_others=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked_copy=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'

	# Hack in support for `room list-untracked -r`...
	exclude_standard_opt='--exclude-standard'
	directory_opt='--directory'
	shift
	while getopts ar flag; do
		case "$flag" in
			a) unset exclude_standard_opt ;;
			r) unset directory_opt ;;
		esac
	done
	shift $((OPTIND-1))
	# ...and parse for a potential parameter afterwards. As we shifted things out of $* in during getops, we need to look at $1
	HOMEROOMS_REPO_NAME=$1; export HOMEROOMS_REPO_NAME

	if [ -n "$HOMEROOMS_REPO_NAME" ]; then
		list_untracked_helper "$HOMEROOMS_REPO_NAME"
	else
		for HOMEROOMS_REPO_NAME in $(list); do
			list_untracked_helper "$HOMEROOMS_REPO_NAME"
		done
	fi
	cat "$temp_file_untracked"

	unset directory_opt directory_component
	rm -f "$temp_file_others" "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not delete temp files'
}

list_untracked_helper() {
	export GIT_DIR="$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git"
	@GIT@ ls-files --others $exclude_standard_opt $directory_opt | (
		while read -r line; do
			echo "$line"
			directory_component=${line%%/*}
			[ -d "$directory_component" ] && printf '%s/\n' "$directory_component"
		done
		) | sort -u > "$temp_file_others"
	if [ -z "$ran_once" ]; then
		ran_once=1
		cp "$temp_file_others" "$temp_file_untracked" || fatal 'Could not copy temp file'
	fi
	cp "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not copy temp file'
	@COMM@ -12 "$temp_file_others" "$temp_file_untracked_copy" > "$temp_file_untracked"
}

pull() {
	hook_global pre-pull
	for HOMEROOMS_REPO_NAME in $(list_has_remote); do
		export HOMEROOMS_REPO_NAME
		printf '%s: ' "$HOMEROOMS_REPO_NAME"
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-pull
		@GIT@ pull
		hook_repo post-pull
		HOMEROOMS_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-pull
}

push() {
	hook_global pre-push
	for HOMEROOMS_REPO_NAME in $(list_has_remote); do
		export HOMEROOMS_REPO_NAME
		printf '%s: ' "$HOMEROOMS_REPO_NAME"
		GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-push
		@GIT@ push
		hook_repo post-push
		HOMEROOMS_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-push
}

retire() {
	unset HOMEROOMS_DIRECTORY
}

rename() {
	git_dir_exists
	[ -d "$GIT_DIR_NEW" ] && fatal "'$GIT_DIR_NEW' exists" 54
	mv -f "$GIT_DIR" "$GIT_DIR_NEW" || fatal "Could not mv '$GIT_DIR' '$GIT_DIR_NEW'" 52
	[ -e "${GIT_DIR%.git}.room" ] && mv -f "${GIT_DIR%.git}.room" "${GIT_DIR_NEW%.git}.room"

	# Now that the repository has been renamed, we need to fix up its configuration
	# Overwrite old name..
	GIT_DIR=$GIT_DIR_NEW
	HOMEROOMS_REPO_NAME=$HOMEROOMS_REPO_NAME_NEW
	# ..and clobber all old configuration
	upgrade
}

run() {
	hook pre-run
	use
	"$@"
	HOMEROOMS_COMMAND_RETURN_CODE=$?
	hook post-run
}

status() {
	if [ -t 1 ]; then
		COLORING="-c color.status=always"
	fi
	if [ -n "$HOMEROOMS_REPO_NAME" ]; then
		status_helper "$HOMEROOMS_REPO_NAME"
	else
		for HOMEROOMS_REPO_NAME in $(list); do
			STATUS="$(status_helper "$HOMEROOMS_REPO_NAME" "$COLORING")"
			[ -n "$STATUS" ] || [ -z "$HOMEROOMS_STATUS_TERSE" ] && echo "$HOMEROOMS_REPO_NAME:"
			[ -n "$STATUS" ]            && echo "$STATUS"
			[ -z "$HOMEROOMS_STATUS_TERSE" ] && echo
		done
	fi
}

# Warning: disabled quoting check here due to all of them relating to
#          wc -l  output and a deliberate lack of quoting for git args.
# shellcheck disable=SC2086
status_helper() {
	GIT_DIR=$HOMEROOMS_REPO_D/$1.git; export GIT_DIR
	HOMEROOMS_GIT_OPTIONS="-c status.relativePaths=false $2"
	use
	# Shellcheck isn't understanding a complex block.
	# shellcheck disable=SC1083
	remote_tracking_branch=$(@GIT@ rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null) && {
		commits_behind=$(@GIT@ log ..${remote_tracking_branch} --oneline | @WC@ -l)
		commits_ahead=$(@GIT@ log ${remote_tracking_branch}.. --oneline | @WC@ -l)
		[ ${commits_behind} -ne 0 ] && echo "Behind $remote_tracking_branch by $commits_behind commits"
		[ ${commits_ahead} -ne 0 ] && echo "Ahead of $remote_tracking_branch by $commits_ahead commits"
	}
	@GIT@ ${HOMEROOMS_GIT_OPTIONS} status --short --untracked-files='no' | @SED@ -E 's@([^ ] +)@\1~/@'
	HOMEROOMS_COMMAND_RETURN_CODE=$?
}

upgrade() {
	hook pre-upgrade
	# fake-bare repositories are not bare, actually. Set this to false
	# because otherwise Git complains "fatal: core.bare and core.worktree
	# do not make sense"
	@GIT@ config core.bare false
	# core.worktree may be absolute or relative to $GIT_DIR, depending on
	# user preference
	if [ ! "x$HOMEROOMS_WORKTREE" = 'xabsolute' ]; then
		@GIT@ config core.worktree "$(cd "$GIT_DIR" && GIT_WORK_TREE=$HOMEROOMS_BASE @GIT@ rev-parse --show-cdup)"
	elif [ ! "x$HOMEROOMS_WORKTREE" = 'xrelative' ]; then
		@GIT@ config core.worktree "$HOMEROOMS_BASE"
	fi
	[ ! "x$HOMEROOMS_GITIGNORE" = 'xnone' ] && @GIT@ config core.excludesfile ".gitignore.d/$HOMEROOMS_REPO_NAME"
	[ ! "x$HOMEROOMS_GITATTRIBUTES" = 'xnone' ] && @GIT@ config core.attributesfile ".gitattributes.d/$HOMEROOMS_REPO_NAME"
	@GIT@ config room.room 'true'
	use
	[ -e "$HOMEROOMS_BASE/.gitignore.d/$HOMEROOMS_REPO_NAME" ] && @GIT@ add -f "$HOMEROOMS_BASE/.gitignore.d/$HOMEROOMS_REPO_NAME"
	[ -e "$HOMEROOMS_BASE/.gitattributes.d/$HOMEROOMS_REPO_NAME" ] && @GIT@ add -f "$HOMEROOMS_BASE/.gitattributes.d/$HOMEROOMS_REPO_NAME"
	hook post-upgrade
}

use() {
	git_dir_exists
	HOMEROOMS_DIRECTORY=$HOMEROOMS_REPO_NAME; export HOMEROOMS_DIRECTORY
}

which() {
	# It's ok to modify HOMEROOMS_REPO_NAME in a subshell.
	# shellcheck disable=SC2030
	output=$(for HOMEROOMS_REPO_NAME in $(list); do
		get_files | @GREP@ -- "$HOMEROOMS_COMMAND_PARAMETER" | @SED@ "s/^/$HOMEROOMS_REPO_NAME: /"
	done | sort -u)
	if [ -z "$output" ]; then
		fatal "'$HOMEROOMS_COMMAND_PARAMETER' does not exist" 1
	else
		echo "$output"
	fi
}

# Ignore warnings about HOMEROOMS_REPO_NAME being changed in a subshell.
# shellcheck disable=SC2031
write_gitignore() {
	# Don't do anything if the user does not want to write gitignore
	if [ "x$HOMEROOMS_GITIGNORE" = 'xnone' ]; then
		info "Not writing gitignore as '\$HOMEROOMS_GITIGNORE' is set to 'none'"
		exit
	fi

	use
	cd "$HOMEROOMS_BASE" || fatal "could not enter '$HOMEROOMS_BASE'" 11
	# Works in all shells we care about.
	# shellcheck disable=SC2039,SC3043
	local GIT_VERSION GIT_VERSION_MAJOR GIT_VERSION_MINOR
	GIT_VERSION="$(@GIT@ --version)"
	GIT_VERSION_MAJOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p')"
	GIT_VERSION_MINOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\.([0-9]+)\..*/\2/p')"
	OLDIFS=$IFS
	IFS=$(printf '\n\t')
	gitignores=$(for file in $(@GIT@ ls-files); do
		while true; do
			echo "$file"; new=${file%/*}
			[ x"$file" = x"$new" ] && break
			file=$new
		done;
	done | sort -u)

	# Contrary to GNU mktemp, mktemp on BSD/OSX requires a template for temp files
	# Using a template makes GNU mktemp default to $PWD and not #TMPDIR for tempfile location
	# To make every OS happy, set full path explicitly
	local tempfile
	tempfile=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") ||
		fatal "could not create tempfile: '${tempfile}'" 51

	echo '*' > "$tempfile" || fatal "could not write to '$tempfile'" 57
	for gitignore in $gitignores; do
		echo "$gitignore" | @SED@ 's@^@!/@' >> "$tempfile" ||
			fatal "could not write to '$tempfile'" 57
		if [ "x$HOMEROOMS_GITIGNORE" = 'xrecursive' ] && [ -d "$gitignore" ]; then
			{ echo "$gitignore/*" | @SED@ 's@^@!/@' >> "$tempfile" ||
				fatal "could not write to '$tempfile'" 57; }
		fi
	done
	IFS=$OLDIFS
	local GIT_IGNORE_PATH
	GIT_IGNORE_PATH="$HOMEROOMS_BASE/.gitignore.d/$HOMEROOMS_REPO_NAME"
	if diff -N "$tempfile" "$GIT_IGNORE_PATH" > /dev/null; then
		info "'$GIT_IGNORE_PATH' already up to date"
		rm -f "$tempfile" || fatal "could not delete '$tempfile'" 59
		return
	fi
	if [ -e "$GIT_IGNORE_PATH" ]; then
		info "'$GIT_IGNORE_PATH' differs from new data, moving it to '$GIT_IGNORE_PATH.bak'"
		mv -f "$GIT_IGNORE_PATH" "$GIT_IGNORE_PATH.bak" ||
			fatal "could not move '$GIT_IGNORE_PATH' to '$GIT_IGNORE_PATH.bak'" 53
	fi
	mv -f "$tempfile" "$GIT_IGNORE_PATH" ||
		fatal "could not move '$tempfile' to '$GIT_IGNORE_PATH'" 53
}

debug "$(@GIT@ version)"

if [ ! "x$HOMEROOMS_GITIGNORE" = 'xexact' ] && [ ! "x$HOMEROOMS_GITIGNORE" = 'xnone' ] && [ ! "x$HOMEROOMS_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$HOMEROOMS_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

HOMEROOMS_COMMAND=$1; export HOMEROOMS_COMMAND

case $HOMEROOMS_COMMAND in
	clon|clo|cl) HOMEROOMS_COMMAND=clone;;
	commi|comm|com|co|ci) HOMEROOMS_COMMAND=commit;;
	delet|dele|del|de) HOMEROOMS_COMMAND=delete;;
	ente|ent|en) HOMEROOMS_COMMAND=enter;;
	hel|he) HOMEROOMS_COMMAND=help;;
	ini|in) HOMEROOMS_COMMAND=init;;
	pul) HOMEROOMS_COMMAND=pull;;
	pus) HOMEROOMS_COMMAND=push;;
	renam|rena|ren|re) HOMEROOMS_COMMAND=rename;;
	ru) HOMEROOMS_COMMAND=run;;
	statu|stat|sta|st) HOMEROOMS_COMMAND=status;;
	upgrad|upgra|upgr|up) HOMEROOMS_COMMAND=upgrade;;
	versio|versi|vers|ver|ve) HOMEROOMS_COMMAND=version;;
	which|whi|wh) HOMEROOMS_COMMAND=which;;
	write|writ|wri|wr) HOMEROOMS_COMMAND=write-gitignore;;
esac

if [ x"$HOMEROOMS_COMMAND" = x'clone' ]; then
	HOMEROOMS_BRANCH=
	if [ "$2" = -b ]; then
		HOMEROOMS_BRANCH=$3
		shift
		shift
	fi
	[ -z "$2" ] && fatal "$HOMEROOMS_COMMAND: please specify a remote" 1
	GIT_REMOTE="$2"
	[ -n "$HOMEROOMS_BRANCH" ] || if [ "$3" = -b ]; then
		HOMEROOMS_BRANCH=$4
		shift
		shift
	fi
	if [ -n "$3" ]; then
		HOMEROOMS_REPO_NAME=$3
		[ -z "$HOMEROOMS_BRANCH" ] && [ "$4" = -b ] && HOMEROOMS_BRANCH=$5
	else
		HOMEROOMS_REPO_NAME=$(basename "${GIT_REMOTE#*:}" .git)
	fi
	[ -z "$HOMEROOMS_REPO_NAME" ] && fatal "$HOMEROOMS_COMMAND: could not determine repository name" 1
	export HOMEROOMS_REPO_NAME
	[ -n "$HOMEROOMS_BRANCH" ] || HOMEROOMS_BRANCH=main
	GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
elif [ "$HOMEROOMS_COMMAND" = 'help' ]; then
	help && exit
elif [ "$HOMEROOMS_COMMAND" = 'version' ]; then
	echo "$HOMEROOMS_SELF $HOMEROOMS_VERSION"
	@GIT@ version
	exit
elif [ x"$HOMEROOMS_COMMAND" = x'which' ]; then
	[ -z "$2" ] && fatal "$HOMEROOMS_COMMAND: please specify a filename" 1
	[ -n "$3" ] && fatal "$HOMEROOMS_COMMAND: too many parameters" 1
	HOMEROOMS_COMMAND_PARAMETER=$2; export HOMEROOMS_COMMAND_PARAMETER
elif [ x"$HOMEROOMS_COMMAND" = x'delete' ]           ||
	[ x"$HOMEROOMS_COMMAND" = x'enter' ]            ||
	[ x"$HOMEROOMS_COMMAND" = x'init' ]             ||
	[ x"$HOMEROOMS_COMMAND" = x'list-tracked-by' ]  ||
	[ x"$HOMEROOMS_COMMAND" = x'rename' ]           ||
	[ x"$HOMEROOMS_COMMAND" = x'run' ]              ||
	[ x"$HOMEROOMS_COMMAND" = x'upgrade' ]          ||
	[ x"$HOMEROOMS_COMMAND" = x'write-gitignore' ]; then
	if [ -z "$2" ]; then
		[ -z "$HOMEROOMS_REPO_NAME" ] && fatal "$HOMEROOMS_COMMAND: please specify repository to work on" 1
	else
		HOMEROOMS_REPO_NAME=$2; export HOMEROOMS_REPO_NAME
	fi
	GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
	[ x"$HOMEROOMS_COMMAND" = x'rename' ] && [ -z "$3" ] && fatal "$HOMEROOMS_COMMAND: please specify a target name" 1
	[ x"$HOMEROOMS_COMMAND" = x'run'    ] && [ -z "$3" ] && fatal "$HOMEROOMS_COMMAND: please specify a command" 1
	[ x"$HOMEROOMS_COMMAND" = x'rename' ] && { HOMEROOMS_REPO_NAME_NEW=$3; export HOMEROOMS_REPO_NAME_NEW;
	GIT_DIR_NEW=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME_NEW.git; export GIT_DIR_NEW; }
	[ x"$HOMEROOMS_COMMAND" = x'run' ]    && shift 2
elif [ x"$HOMEROOMS_COMMAND" = x'foreach' ]; then
	[ -z "$2" ] && fatal "$HOMEROOMS_COMMAND: please specify a command" 1
	shift 1
elif [ x"$HOMEROOMS_COMMAND" = x'commit' ] ||
	[ x"$HOMEROOMS_COMMAND" = x'list'   ] ||
	[ x"$HOMEROOMS_COMMAND" = x'list-tracked' ] ||
	[ x"$HOMEROOMS_COMMAND" = x'list-untracked' ] ||
	[ x"$HOMEROOMS_COMMAND" = x'manifest' ] ||
	[ x"$HOMEROOMS_COMMAND" = x'restore' ] ||
	[ x"$HOMEROOMS_COMMAND" = x'pull'   ] ||
	[ x"$HOMEROOMS_COMMAND" = x'push'   ]; then
	:
elif [ x"$HOMEROOMS_COMMAND" = x'status' ]; then
	if [ x"$2" = x'--terse' ]; then
		HOMEROOMS_STATUS_TERSE=1; export HOMEROOMS_STATUS_TERSE
		shift
	fi
	HOMEROOMS_REPO_NAME=$2; export HOMEROOMS_REPO_NAME
elif [ -n "$2" ]; then
	HOMEROOMS_COMMAND='run'; export HOMEROOMS_COMMAND
	HOMEROOMS_REPO_NAME=$1; export HOMEROOMS_REPO_NAME
	GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
	shift 1
	set -- "@GIT@" "$@"
elif [ -n "$HOMEROOMS_COMMAND" ]; then
	HOMEROOMS_COMMAND='enter'; export HOMEROOMS_COMMAND
	HOMEROOMS_REPO_NAME=$1; export HOMEROOMS_REPO_NAME
	GIT_DIR=$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
else
	# $1 is empty
	help && exit 1
fi

# Did we receive a directory instead of a name?
# Mangle the input to fit normal operation.
if echo "$HOMEROOMS_REPO_NAME" | @GREP@ -q '/'; then
	GIT_DIR=$HOMEROOMS_REPO_NAME; export GIT_DIR
	HOMEROOMS_REPO_NAME=$(basename "$HOMEROOMS_REPO_NAME" .git); export HOMEROOMS_REPO_NAME
fi

check_dir() {
	check_directory="$1"
	if [ ! -d "$check_directory" ]; then
		if [ -e "$check_directory" ]; then
			fatal "'$check_directory' exists but is not a directory" 13
		else
			verbose "attempting to create '$check_directory'"
			mkdir -p "$check_directory" || fatal "could not create '$check_directory'" 50
		fi
	fi
}

check_dir "$HOMEROOMS_REPO_D"
[ ! "x$HOMEROOMS_GITIGNORE" = 'xnone' ] && check_dir "$HOMEROOMS_BASE/.gitignore.d"
[ ! "x$HOMEROOMS_GITATTRIBUTES" = 'xnone' ] && check_dir "$HOMEROOMS_BASE/.gitattributes.d"

verbose "$HOMEROOMS_COMMAND begin"
HOMEROOMS_COMMAND=$(echo "$HOMEROOMS_COMMAND" | @SED@ 's/-/_/g'); export HOMEROOMS_COMMAND

# Source repo-specific configuration file, if present: rooms/<repo>.room
# shellcheck source=/dev/null
[ -r "$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.room" ] \
	&& . "$HOMEROOMS_REPO_D/$HOMEROOMS_REPO_NAME.room"

# source overlay functions
for overlay in "$HOMEROOMS_OVERLAY_D/$HOMEROOMS_COMMAND"* "$HOMEROOMS_OVERLAY_D/$HOMEROOMS_REPO_NAME.$HOMEROOMS_COMMAND"*; do
	[ -r "$overlay" ] || continue
	info "sourcing '$overlay'"
	# shellcheck source=/dev/null
	. "$overlay"
done

hook pre-command
$HOMEROOMS_COMMAND "$@"
hook post-command
verbose "$HOMEROOMS_COMMAND end, exiting"
exit $HOMEROOMS_COMMAND_RETURN_CODE

# Local Variables:
# mode:shell-script
# sh-shell:sh
# End:
# vim: ft=sh:
