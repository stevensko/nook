#!@SHELL@
# Copyright (C) 2011-2015 Richard "RichiH" Hartmann <richih@debian.org>, see CONTRIBUTORS for details.
# SPDX-License-Identifier: GPL-2.0-or-later
#
# While the following is not legally binding, the author would like to explain
# the choice of GPLv2+ over GPLv3+. The author prefers GPLv3+ over GPLv2+ but
# feels it's better to maintain full compatibility's with Git. In case Git ever
# changes its licensing terms, which is admittedly extremely unlikely to the
# point of being impossible, this software will most likely follow suit.

# This should always be the first line of code to facilitate debugging
[ -n "$STACHE_DEBUG" ] && set -vx

# If '.r<N>-g<SHA>' is appended to the version, you are seeing an unreleased
# version built from the main branch HEAD. If "-standalone" is appended you are
# using a version built explicitly for portability as a standalone script
# rather than being installed to a specific system.
STACHE_VERSION='@VERSION@@DEPLOYMENT@'; export STACHE_VERSION
STACHE_SELF='stache'; export STACHE_SELF

# Ensure all files created are accessible only to the current user.
umask 0077

fatal() {
	echo "$STACHE_SELF: fatal: $1" >&2
	[ -z "$2" ] && exit 1
	exit "$2"
}

# We need to run getops as soon as possible so we catch -d and other
# options that will modify our behaviour.
# Commands are handled at the end of this script.
# shellcheck disable=SC2220
while getopts c:dv flag; do
	case "$flag" in
		d)
			set -vx
			STACHE_DEBUG=1
			export STACHE_DEBUG
			echo 'debug mode on'
			echo "$STACHE_SELF $STACHE_VERSION"
			;;
		v)
			STACHE_VERBOSE=1
			export STACHE_VERBOSE
			echo 'verbose mode on'
			echo "$STACHE_SELF $STACHE_VERSION"
			;;
		c)
			STACHE_OPTION_CONFIG="$OPTARG"
			export STACHE_OPTION_CONFIG
			;;
	esac
done
shift $((OPTIND-1))

source_all() {
	# Source file even if it's in $PWD and does not have any slashes in it
	# shellcheck source=/dev/null
	case "$1" in
		*/*) . "$1";;
		*)   . "$PWD/$1";;
	esac;
}


# Read configuration and set defaults if anything's not set
[ -n "$STACHE_DEBUG" ]                  && set -vx
: "${XDG_CONFIG_HOME:="$HOME/.config"}"

# Read configuration files if there are any
# shellcheck source=/dev/null
[ -r "/etc/stache/config" ]             && . "/etc/stache/config"
# shellcheck source=/dev/null
[ -r "$XDG_CONFIG_HOME/stache/config" ] && . "$XDG_CONFIG_HOME/stache/config"
if [ -n "$STACHE_OPTION_CONFIG" ]; then
	# Source $STACHE_OPTION_CONFIG if it can be read and is in $PWD of $PATH
	if [ -r "$STACHE_OPTION_CONFIG" ]; then
		source_all "$STACHE_OPTION_CONFIG"
	else
		fatal "Can not read configuration file '$STACHE_OPTION_CONFIG'" 1
	fi
fi
[ -n "$STACHE_DEBUG" ]                  && set -vx

# Read defaults
: "${STACHE_REPO_D:="$XDG_CONFIG_HOME/stache"}"; export STACHE_REPO_D
: "${STACHE_HOOK_D:="$XDG_CONFIG_HOME/stache/hooks"}"; export STACHE_HOOK_D
: "${STACHE_OVERLAY_D:="$XDG_CONFIG_HOME/stache/overlays"}"; export STACHE_OVERLAY_D
: "${STACHE_REPOS:="$XDG_CONFIG_HOME/stache/stache.repos"}"; export STACHE_REPOS
: "${STACHE_BASE:="$HOME"}"; export STACHE_BASE
: "${STACHE_GITIGNORE:=exact}"; export STACHE_GITIGNORE
: "${STACHE_GITATTRIBUTES:=none}"; export STACHE_GITATTRIBUTES
: "${STACHE_WORKTREE:=absolute}"; export STACHE_WORKTREE
: "${STACHE_SHOW_UNTRACKED:=no}"; export STACHE_SHOW_UNTRACKED
: "${STACHE_GITCONFIG:="$XDG_CONFIG_HOME/stache/.gitconfig"}"; export STACHE_GITCONFIG
: "${STACHE_GITIGNORE_FILE:="$XDG_CONFIG_HOME/stache/.gitignore"}"; export STACHE_GITIGNORE_FILE
: "${STACHE_GITATTRIBUTES_FILE:="$XDG_CONFIG_HOME/stache/.gitattributes"}"; export STACHE_GITATTRIBUTES_FILE

if [ ! "x$STACHE_GITIGNORE" = 'xexact' ] && [ ! "x$STACHE_GITIGNORE" = 'xnone' ] && [ ! "x$STACHE_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$STACHE_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

if [ ! "x$STACHE_WORKTREE" = 'xabsolute' ] && [ ! "x$STACHE_WORKTREE" = 'xrelative' ]; then
	fatal "'\$STACHE_WORKTREE' must equal 'absolute', or 'relative'" 1
fi


# editorconfig-checker-disable
help() {
	echo "usage: $STACHE_SELF <options> <command>

   options:
   -c <file>            Source file
   -d                   Enable debug mode
   -v                   Enable verbose mode

   commands:
   clone [-b <branch>] \\
         <remote> \\
         [<repo>]       Clone from an existing repository
   commit               Commit in all repositories
   config \\
     [<git config args>] Edit shared git config included by every repo
                        (\$STACHE_GITCONFIG); no args lists it
   delete <repo>        Delete an existing repository
   enter <repo>         Enter repository; spawn new instance of \$SHELL
                        with \$GIT_DIR set.
   foreach \\
     [<-g>] [<-p>] \\
     <git command>      Execute a command for every repository
   help                 Display this help text
   init <repo>          Initialize a new repository
   list                 List all repositories
   list-tracked \\
        [<repo>]        List all files tracked all or one repositories
   list-untracked \\
        [<-a>] [<-r>]
        [<repo>]        List all files not tracked by all or one repositories
   pull                 Pull from all stache remotes
   push                 Push to stache remotes
   restore [<file>]     Clone every repo listed in \$STACHE_REPOS
                        (\$XDG_CONFIG_HOME/stache/stache.repos), which stache
                        maintains automatically
   rename <repo> \\
          <newname>     Rename repository
   run <repo> \\
       <command>        Use this repository
   status \\
     [--terse] [<repo>] Show statuses of all/one stache repositories
   upgrade <repo>       Upgrade repository to currently recommended settings
   version              Print version information
   which <substring>    Find substring in name of any tracked file
   write-gitignore \\
   [<repo>]             Write <repo>.stache/.gitignore via git ls-files

   <repo> <git command> Shortcut to run git commands directly
   <repo>               Shortcut to enter repository" >&2
}
# editorconfig-checker-enable

debug() {
	if [ -n "$STACHE_DEBUG" ]; then echo "$STACHE_SELF: debug: $*"; fi
}

verbose() {
	if [ -n "$STACHE_DEBUG" ] || [ -n "$STACHE_VERBOSE" ]; then
		echo "$STACHE_SELF: verbose: $*"
	fi
}

error() {
	echo "$STACHE_SELF: error: $1" >&2
}

info() {
	echo "$STACHE_SELF: info: $1"
}

clone() {
	hook pre-clone
	# Check if remote is reachable. Abort early if there's a typo, TLS certificate problem, etc
	@GIT@ ls-remote "$GIT_REMOTE" 2> /dev/null || fatal "Can not reach '$GIT_REMOTE'"
	init
	# Test which, if any, given or detected branches can be pulled from.
	# In a future version, if we need the logic, we could do the following:
	#   git ls-remote ORIGIN
	#   get HEAD commit ID
	#   see what refs/heads/* match that commit ID
	#   set STACHE_BRANCH if only one match
	#   offer a list of all matching refs for the user to choose
	for STACHE_BRANCH_TEST in "$STACHE_BRANCH" master trunk development; do
		if [ $(@GIT@ ls-remote "$GIT_REMOTE" "$STACHE_BRANCH_TEST" 2> /dev/null | @WC@ -l ) -lt 1 ]; then
			info "remote branch '$STACHE_BRANCH_TEST' empty"
		else
			info "remote branch '$STACHE_BRANCH_TEST' found"
			STACHE_BRANCH_REMOTE=$STACHE_BRANCH_TEST
			break
		fi
	done
	if [ -z "$STACHE_BRANCH_REMOTE" ]; then
		info "No non-empty remote branches found, aborting. Please run `$0 delete $STACHE_REPO_NAME`, determine the correct branch, and try again."
		exit
	fi
	STACHE_BRANCH=$STACHE_BRANCH_REMOTE

	# Set up remote
	@GIT@ remote add origin "$GIT_REMOTE"
	@GIT@ checkout -b "$STACHE_BRANCH" || return $?
	@GIT@ config branch."$STACHE_BRANCH".remote origin
	@GIT@ config branch."$STACHE_BRANCH".merge  refs/heads/"$STACHE_BRANCH"
	GIT_VERSION_MAJOR=$(@GIT@ --version | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p' )
	if [ 1 -lt "$GIT_VERSION_MAJOR" ];then
		@GIT@ fetch origin "$STACHE_BRANCH"
	else
		@GIT@ fetch origin
	fi
	hook pre-merge
	@GIT@ read-tree -n -mu origin/"$STACHE_BRANCH" \
		|| fatal "will stop after fetching and not try to merge!
  Once this situation has been resolved, run 'stache $STACHE_REPO_NAME pull' to finish cloning." 17 # editorconfig-checker-disable-line
	@GIT@ -c merge.ff=true merge origin/"$STACHE_BRANCH"
	hook post-merge
	hook post-clone
	retire
	hook post-clone-retired
}

commit() {
	hook_global pre-commit
	shift  # remove the "commit" command.
	for STACHE_REPO_NAME in $(list); do
		export STACHE_REPO_NAME
		echo "$STACHE_REPO_NAME: "
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-commit
		@GIT@ commit --untracked-files=no --quiet "$@"
		hook_repo post-commit
		STACHE_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-commit
}

delete() {
	cd "$STACHE_BASE" || fatal "could not enter '$STACHE_BASE'" 11
	use
	info "This operation WILL DESTROY DATA!"
	files=$(@GIT@ ls-files)
	echo "These files will be deleted:

$files

AGAIN, THIS WILL DELETE YOUR DATA!
To continue, type 'Yes, do as I say'"
	read -r answer
	[ "x$answer" = 'xYes, do as I say' ] || exit 16
	# Use -z/-0 so that paths containing whitespace, shell globbing
	# characters, or non-ASCII bytes (which `git ls-files` would otherwise
	# C-quote) are handled verbatim; `--` guards against leading dashes.
	@GIT@ ls-files -z | xargs -0 rm -f -- ||
		info "could not delete some files, continuing with repository deletion"
	# Remove the whole <name>.stache/ container (git dir, per-repo config,
	# per-repo gitignore/gitattributes).
	rm -rf "${GIT_DIR%/*}" || error "could not delete '${GIT_DIR%/*}'"
}

enter() {
	hook pre-enter
	use
	$SHELL
	hook post-enter
}

foreach() {
	hook_global pre-foreach

	# We default to prefixing `git` to all commands passed to foreach, but
	# allow running in general context with -g
	command_prefix=@GIT@
	# shellcheck disable=SC2220
	while getopts gp flag; do
		case "$flag" in
			g) unset command_prefix ;;
			p) STACHE_PRINT_REPO_PREFIX=1 ;;
		esac
	done
	shift $((OPTIND-1))
	export STACHE_PRINT_REPO_PREFIX
	for STACHE_REPO_NAME in $(list); do
		export STACHE_REPO_NAME
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-foreach
		if [ -n "${STACHE_PRINT_REPO_PREFIX+x}" ]; then
			$command_prefix "$@" | @SED@ "s/^/$STACHE_REPO_NAME: /"
		else
			echo "$STACHE_REPO_NAME:"
			$command_prefix "$@"
		fi
		hook_repo post-foreach
	done
	hook_global post-foreach
}

git_dir_exists() {
	[ -d "$GIT_DIR" ] || fatal "no repository found for '$STACHE_REPO_NAME'" 12
}

hook_global() {
	for hook in "$STACHE_HOOK_D/$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook"
	done
}

hook_repo() {
	for hook in "$STACHE_HOOK_D/$STACHE_REPO_NAME.$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook" || fatal "hook [$hook] failed" 1
	done
}

hook() {
	hook_global "$1"
	hook_repo "$1"
}

init() {
	hook pre-init
	[ ! -e "$GIT_DIR" ] || fatal "'$GIT_DIR' exists" 10
	mkdir -p "$STACHE_BASE" || fatal "could not create '$STACHE_BASE'" 50
	mkdir -p "${GIT_DIR%/*}" || fatal "could not create '${GIT_DIR%/*}'" 50
	cd "$STACHE_BASE" || fatal "could not enter '$STACHE_BASE'" 11
	@GIT@ init --shared=false
	upgrade
	hook post-init
}

list() {
	for repo in "$STACHE_REPO_D"/*.stache; do
		[ -d "$repo" ] || continue
		name=$(basename "$repo" .stache)
		[ -d "$repo/$name.git" ] && [ -r "$repo/$name.git" ] && echo "$name"
	done
}

list_has_remote() {
	for STACHE_REPO_NAME in $(list); do
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
		# This command returns the tracking branch of the currently-checked-out local
		# branch, if any. See https://stackoverflow.com/a/9753364
		[ -n  "$(@GIT@ for-each-ref "$(@GIT@ symbolic-ref -q HEAD)")" ] && echo "$STACHE_REPO_NAME"
	done
}

config() {
	# Read/write $STACHE_GITCONFIG, a git config file that every stache repo
	# includes (wired up by upgrade()). Args are passed straight to
	# `git config`, e.g.  stache config credential.helper '!gh auth git-credential'
	# With no args, list the current contents.
	shift
	[ -e "$STACHE_GITCONFIG" ] || : > "$STACHE_GITCONFIG" ||
		fatal "could not create '$STACHE_GITCONFIG'" 50
	[ "$#" -eq 0 ] && set -- --list
	# Run from / so a stray/broken .git in the cwd's ancestry (e.g. a
	# leftover gitlink in $HOME) cannot make repo discovery fail here.
	@GIT@ -C / config --file "$STACHE_GITCONFIG" "$@"
	STACHE_COMMAND_RETURN_CODE=$?
}

write_repos_file() {
	# Regenerate $STACHE_REPOS ("<name> <url> <branch>" per repo with an
	# 'origin' remote). Called automatically after init/clone/delete/rename/
	# upgrade/restore. Only rewrites the file if its content changed.
	local tmp
	tmp=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || return 0
	echo "# stache repos -- managed automatically; fields: <name> <url> <branch>" > "$tmp"
	for STACHE_REPO_NAME in $(list); do
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR STACHE_REPO_NAME
		url=$(@GIT@ config --get remote.origin.url 2> /dev/null) || continue
		[ -n "$url" ] || continue
		branch=$(@GIT@ symbolic-ref --quiet --short HEAD 2> /dev/null) || branch=
		printf '%s %s %s\n' "$STACHE_REPO_NAME" "$url" "$branch" >> "$tmp"
	done
	if diff -N "$tmp" "$STACHE_REPOS" > /dev/null 2>&1; then
		rm -f "$tmp"
	else
		mv -f "$tmp" "$STACHE_REPOS" 2> /dev/null || rm -f "$tmp"
	fi
}

restore() {
	# Clone every repo listed in $STACHE_REPOS that is not already present.
	source_file=${2:-$STACHE_REPOS}
	[ -r "$source_file" ] || fatal "$STACHE_COMMAND: repos file not readable: '$source_file'" 1
	# Fields are whitespace-separated; none of name/url/branch can contain a space.
	while read -r name url branch; do
		case "$name" in ''|\#*) continue;; esac
		if [ -z "$url" ]; then
			info "skipping '$name': no URL in repos file"
			continue
		fi
		if [ -e "$STACHE_REPO_D/$name.stache/$name.git" ]; then
			info "skipping '$name': already present"
			continue
		fi
		info "cloning '$name' from '$url'"
		if [ -n "$branch" ]; then
			"$0" clone -b "$branch" "$url" "$name" || error "failed to clone '$name'"
		else
			"$0" clone "$url" "$name" || error "failed to clone '$name'"
		fi
	done < "$source_file"
}

get_files() {
	GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
	@GIT@ ls-files --full-name
}

list_tracked() {
	STACHE_REPO_NAME=$2; export STACHE_REPO_NAME
	if [ -n "$STACHE_REPO_NAME" ]; then
		get_files | list_tracked_helper
	else
		for STACHE_REPO_NAME in $(list); do
			get_files
		done | list_tracked_helper
	fi
}

list_tracked_helper() {
	@SED@ "s,^,$(printf '%s\n' "$STACHE_BASE/" | @SED@ 's/[,\&]/\\&/g')," | sort -u
}

list_tracked_by() {
	list_tracked '' "$2"
}

list_untracked() {
	temp_file_others=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked_copy=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'

	# Hack in support for `stache list-untracked -r`...
	exclude_standard_opt='--exclude-standard'
	directory_opt='--directory'
	shift
	while getopts ar flag; do
		case "$flag" in
			a) unset exclude_standard_opt ;;
			r) unset directory_opt ;;
		esac
	done
	shift $((OPTIND-1))
	# ...and parse for a potential parameter afterwards. As we shifted things out of $* in during getops, we need to look at $1
	STACHE_REPO_NAME=$1; export STACHE_REPO_NAME

	if [ -n "$STACHE_REPO_NAME" ]; then
		list_untracked_helper "$STACHE_REPO_NAME"
	else
		for STACHE_REPO_NAME in $(list); do
			list_untracked_helper "$STACHE_REPO_NAME"
		done
	fi
	cat "$temp_file_untracked"

	unset directory_opt directory_component
	rm -f "$temp_file_others" "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not delete temp files'
}

list_untracked_helper() {
	export GIT_DIR="$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git"
	@GIT@ ls-files --others $exclude_standard_opt $directory_opt | (
		while read -r line; do
			echo "$line"
			directory_component=${line%%/*}
			[ -d "$directory_component" ] && printf '%s/\n' "$directory_component"
		done
		) | sort -u > "$temp_file_others"
	if [ -z "$ran_once" ]; then
		ran_once=1
		cp "$temp_file_others" "$temp_file_untracked" || fatal 'Could not copy temp file'
	fi
	cp "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not copy temp file'
	@COMM@ -12 "$temp_file_others" "$temp_file_untracked_copy" > "$temp_file_untracked"
}

pull() {
	hook_global pre-pull
	for STACHE_REPO_NAME in $(list_has_remote); do
		export STACHE_REPO_NAME
		printf '%s: ' "$STACHE_REPO_NAME"
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-pull
		@GIT@ pull
		hook_repo post-pull
		STACHE_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-pull
}

push() {
	hook_global pre-push
	for STACHE_REPO_NAME in $(list_has_remote); do
		export STACHE_REPO_NAME
		printf '%s: ' "$STACHE_REPO_NAME"
		GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-push
		@GIT@ push
		hook_repo post-push
		STACHE_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-push
}

retire() {
	unset STACHE_DIRECTORY
}

rename() {
	git_dir_exists
	stache_dir_old=${GIT_DIR%/*}
	stache_dir_new=${GIT_DIR_NEW%/*}
	[ -e "$stache_dir_new" ] && fatal "'$stache_dir_new' exists" 54
	# Move the whole <name>.stache/ container, then rename the git dir inside it.
	mv -f "$stache_dir_old" "$stache_dir_new" ||
		fatal "Could not mv '$stache_dir_old' '$stache_dir_new'" 52
	mv -f "$stache_dir_new/$STACHE_REPO_NAME.git" "$GIT_DIR_NEW" ||
		fatal "Could not rename git dir to '$GIT_DIR_NEW'" 52

	# Now that the repository has been renamed, we need to fix up its configuration
	# Overwrite old name..
	GIT_DIR=$GIT_DIR_NEW
	STACHE_REPO_NAME=$STACHE_REPO_NAME_NEW
	# ..and clobber all old configuration
	upgrade
}

run() {
	hook pre-run
	use
	"$@"
	STACHE_COMMAND_RETURN_CODE=$?
	hook post-run
}

status() {
	if [ -t 1 ]; then
		COLORING="-c color.status=always"
	fi
	if [ -n "$STACHE_REPO_NAME" ]; then
		status_helper "$STACHE_REPO_NAME"
	else
		for STACHE_REPO_NAME in $(list); do
			STATUS="$(status_helper "$STACHE_REPO_NAME" "$COLORING")"
			[ -n "$STATUS" ] || [ -z "$STACHE_STATUS_TERSE" ] && echo "$STACHE_REPO_NAME:"
			[ -n "$STATUS" ]            && echo "$STATUS"
			[ -z "$STACHE_STATUS_TERSE" ] && echo
		done
	fi
}

# Warning: disabled quoting check here due to all of them relating to
#          wc -l  output and a deliberate lack of quoting for git args.
# shellcheck disable=SC2086
status_helper() {
	GIT_DIR=$STACHE_REPO_D/$1.stache/$1.git; export GIT_DIR
	STACHE_GIT_OPTIONS="-c status.relativePaths=false $2"
	use
	# Shellcheck isn't understanding a complex block.
	# shellcheck disable=SC1083
	remote_tracking_branch=$(@GIT@ rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null) && {
		commits_behind=$(@GIT@ log ..${remote_tracking_branch} --oneline | @WC@ -l)
		commits_ahead=$(@GIT@ log ${remote_tracking_branch}.. --oneline | @WC@ -l)
		[ ${commits_behind} -ne 0 ] && echo "Behind $remote_tracking_branch by $commits_behind commits"
		[ ${commits_ahead} -ne 0 ] && echo "Ahead of $remote_tracking_branch by $commits_ahead commits"
	}
	@GIT@ ${STACHE_GIT_OPTIONS} status --short --untracked-files='no' | @SED@ -E 's@([^ ] +)@\1~/@'
	STACHE_COMMAND_RETURN_CODE=$?
}

upgrade() {
	hook pre-upgrade
	# fake-bare repositories are not bare, actually. Set this to false
	# because otherwise Git complains "fatal: core.bare and core.worktree
	# do not make sense"
	@GIT@ config core.bare false
	# core.worktree may be absolute or relative to $GIT_DIR, depending on
	# user preference
	if [ ! "x$STACHE_WORKTREE" = 'xabsolute' ]; then
		@GIT@ config core.worktree "$(cd "$GIT_DIR" && GIT_WORK_TREE=$STACHE_BASE @GIT@ rev-parse --show-cdup)"
	elif [ ! "x$STACHE_WORKTREE" = 'xrelative' ]; then
		@GIT@ config core.worktree "$STACHE_BASE"
	fi
	# Per-repo exclude/attributes file lives in <name>.stache/ next to the
	# git dir; if absent, fall back to the shared file in $XDG_CONFIG_HOME/stache.
	if [ ! "x$STACHE_GITIGNORE" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitignore" ]; then
			@GIT@ config core.excludesfile "${GIT_DIR%/*}/.gitignore"
		else
			@GIT@ config core.excludesfile "$STACHE_GITIGNORE_FILE"
		fi
	fi
	if [ ! "x$STACHE_GITATTRIBUTES" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitattributes" ]; then
			@GIT@ config core.attributesfile "${GIT_DIR%/*}/.gitattributes"
		else
			@GIT@ config core.attributesfile "$STACHE_GITATTRIBUTES_FILE"
		fi
	fi
	@GIT@ config stache.stache 'true'
	# Hide the rest of $HOME from `git status` in this repo. Override with
	# STACHE_SHOW_UNTRACKED=normal (or per repo: stache <repo> config
	# status.showUntrackedFiles normal).
	@GIT@ config status.showUntrackedFiles "$STACHE_SHOW_UNTRACKED"
	# Pull in shared settings (credential.helper, user.*, ...) that apply to
	# every stache repo. Edit that file with `stache config ...`.
	@GIT@ config --replace-all include.path "$STACHE_GITCONFIG"
	use
	hook post-upgrade
}

use() {
	git_dir_exists
	STACHE_DIRECTORY=$STACHE_REPO_NAME; export STACHE_DIRECTORY
}

which() {
	# It's ok to modify STACHE_REPO_NAME in a subshell.
	# shellcheck disable=SC2030
	output=$(for STACHE_REPO_NAME in $(list); do
		get_files | @GREP@ -- "$STACHE_COMMAND_PARAMETER" | @SED@ "s/^/$STACHE_REPO_NAME: /"
	done | sort -u)
	if [ -z "$output" ]; then
		fatal "'$STACHE_COMMAND_PARAMETER' does not exist" 1
	else
		echo "$output"
	fi
}

# Ignore warnings about STACHE_REPO_NAME being changed in a subshell.
# shellcheck disable=SC2031
write_gitignore() {
	# Don't do anything if the user does not want to write gitignore
	if [ "x$STACHE_GITIGNORE" = 'xnone' ]; then
		info "Not writing gitignore as '\$STACHE_GITIGNORE' is set to 'none'"
		exit
	fi

	use
	cd "$STACHE_BASE" || fatal "could not enter '$STACHE_BASE'" 11
	# Works in all shells we care about.
	# shellcheck disable=SC2039,SC3043
	local GIT_VERSION GIT_VERSION_MAJOR GIT_VERSION_MINOR
	GIT_VERSION="$(@GIT@ --version)"
	GIT_VERSION_MAJOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p')"
	GIT_VERSION_MINOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\.([0-9]+)\..*/\2/p')"
	OLDIFS=$IFS
	IFS=$(printf '\n\t')
	gitignores=$(for file in $(@GIT@ ls-files); do
		while true; do
			echo "$file"; new=${file%/*}
			[ x"$file" = x"$new" ] && break
			file=$new
		done;
	done | sort -u)

	# Contrary to GNU mktemp, mktemp on BSD/OSX requires a template for temp files
	# Using a template makes GNU mktemp default to $PWD and not #TMPDIR for tempfile location
	# To make every OS happy, set full path explicitly
	local tempfile
	tempfile=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") ||
		fatal "could not create tempfile: '${tempfile}'" 51

	echo '*' > "$tempfile" || fatal "could not write to '$tempfile'" 57
	for gitignore in $gitignores; do
		echo "$gitignore" | @SED@ 's@^@!/@' >> "$tempfile" ||
			fatal "could not write to '$tempfile'" 57
		if [ "x$STACHE_GITIGNORE" = 'xrecursive' ] && [ -d "$gitignore" ]; then
			{ echo "$gitignore/*" | @SED@ 's@^@!/@' >> "$tempfile" ||
				fatal "could not write to '$tempfile'" 57; }
		fi
	done
	IFS=$OLDIFS
	local GIT_IGNORE_PATH
	GIT_IGNORE_PATH="${GIT_DIR%/*}/.gitignore"
	if diff -N "$tempfile" "$GIT_IGNORE_PATH" > /dev/null; then
		info "'$GIT_IGNORE_PATH' already up to date"
		rm -f "$tempfile" || fatal "could not delete '$tempfile'" 59
		return
	fi
	if [ -e "$GIT_IGNORE_PATH" ]; then
		info "'$GIT_IGNORE_PATH' differs from new data, moving it to '$GIT_IGNORE_PATH.bak'"
		mv -f "$GIT_IGNORE_PATH" "$GIT_IGNORE_PATH.bak" ||
			fatal "could not move '$GIT_IGNORE_PATH' to '$GIT_IGNORE_PATH.bak'" 53
	fi
	mv -f "$tempfile" "$GIT_IGNORE_PATH" ||
		fatal "could not move '$tempfile' to '$GIT_IGNORE_PATH'" 53
}

debug "$(@GIT@ version)"

if [ ! "x$STACHE_GITIGNORE" = 'xexact' ] && [ ! "x$STACHE_GITIGNORE" = 'xnone' ] && [ ! "x$STACHE_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$STACHE_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

STACHE_COMMAND=$1; export STACHE_COMMAND

case $STACHE_COMMAND in
	clon|clo|cl) STACHE_COMMAND=clone;;
	commi|comm|com|co|ci) STACHE_COMMAND=commit;;
	confi|conf|con) STACHE_COMMAND=config;;
	delet|dele|del|de) STACHE_COMMAND=delete;;
	ente|ent|en) STACHE_COMMAND=enter;;
	hel|he) STACHE_COMMAND=help;;
	ini|in) STACHE_COMMAND=init;;
	pul) STACHE_COMMAND=pull;;
	pus) STACHE_COMMAND=push;;
	renam|rena|ren|re) STACHE_COMMAND=rename;;
	ru) STACHE_COMMAND=run;;
	statu|stat|sta|st) STACHE_COMMAND=status;;
	upgrad|upgra|upgr|up) STACHE_COMMAND=upgrade;;
	versio|versi|vers|ver|ve) STACHE_COMMAND=version;;
	which|whi|wh) STACHE_COMMAND=which;;
	write|writ|wri|wr) STACHE_COMMAND=write-gitignore;;
esac

if [ x"$STACHE_COMMAND" = x'clone' ]; then
	STACHE_BRANCH=
	if [ "$2" = -b ]; then
		STACHE_BRANCH=$3
		shift
		shift
	fi
	[ -z "$2" ] && fatal "$STACHE_COMMAND: please specify a remote" 1
	GIT_REMOTE="$2"
	[ -n "$STACHE_BRANCH" ] || if [ "$3" = -b ]; then
		STACHE_BRANCH=$4
		shift
		shift
	fi
	if [ -n "$3" ]; then
		STACHE_REPO_NAME=$3
		[ -z "$STACHE_BRANCH" ] && [ "$4" = -b ] && STACHE_BRANCH=$5
	else
		STACHE_REPO_NAME=$(basename "${GIT_REMOTE#*:}" .git)
	fi
	[ -z "$STACHE_REPO_NAME" ] && fatal "$STACHE_COMMAND: could not determine repository name" 1
	export STACHE_REPO_NAME
	[ -n "$STACHE_BRANCH" ] || STACHE_BRANCH=main
	GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
elif [ "$STACHE_COMMAND" = 'help' ]; then
	help && exit
elif [ "$STACHE_COMMAND" = 'version' ]; then
	echo "$STACHE_SELF $STACHE_VERSION"
	@GIT@ version
	exit
elif [ x"$STACHE_COMMAND" = x'which' ]; then
	[ -z "$2" ] && fatal "$STACHE_COMMAND: please specify a filename" 1
	[ -n "$3" ] && fatal "$STACHE_COMMAND: too many parameters" 1
	STACHE_COMMAND_PARAMETER=$2; export STACHE_COMMAND_PARAMETER
elif [ x"$STACHE_COMMAND" = x'delete' ]           ||
	[ x"$STACHE_COMMAND" = x'enter' ]            ||
	[ x"$STACHE_COMMAND" = x'init' ]             ||
	[ x"$STACHE_COMMAND" = x'list-tracked-by' ]  ||
	[ x"$STACHE_COMMAND" = x'rename' ]           ||
	[ x"$STACHE_COMMAND" = x'run' ]              ||
	[ x"$STACHE_COMMAND" = x'upgrade' ]          ||
	[ x"$STACHE_COMMAND" = x'write-gitignore' ]; then
	if [ -z "$2" ]; then
		[ -z "$STACHE_REPO_NAME" ] && fatal "$STACHE_COMMAND: please specify repository to work on" 1
	else
		STACHE_REPO_NAME=$2; export STACHE_REPO_NAME
	fi
	GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
	[ x"$STACHE_COMMAND" = x'rename' ] && [ -z "$3" ] && fatal "$STACHE_COMMAND: please specify a target name" 1
	[ x"$STACHE_COMMAND" = x'run'    ] && [ -z "$3" ] && fatal "$STACHE_COMMAND: please specify a command" 1
	[ x"$STACHE_COMMAND" = x'rename' ] && { STACHE_REPO_NAME_NEW=$3; export STACHE_REPO_NAME_NEW;
	GIT_DIR_NEW=$STACHE_REPO_D/$STACHE_REPO_NAME_NEW.stache/$STACHE_REPO_NAME_NEW.git; export GIT_DIR_NEW; }
	[ x"$STACHE_COMMAND" = x'run' ]    && shift 2
elif [ x"$STACHE_COMMAND" = x'foreach' ]; then
	[ -z "$2" ] && fatal "$STACHE_COMMAND: please specify a command" 1
	shift 1
elif [ x"$STACHE_COMMAND" = x'commit' ] ||
	[ x"$STACHE_COMMAND" = x'config' ] ||
	[ x"$STACHE_COMMAND" = x'list'   ] ||
	[ x"$STACHE_COMMAND" = x'list-tracked' ] ||
	[ x"$STACHE_COMMAND" = x'list-untracked' ] ||
	[ x"$STACHE_COMMAND" = x'restore' ] ||
	[ x"$STACHE_COMMAND" = x'pull'   ] ||
	[ x"$STACHE_COMMAND" = x'push'   ]; then
	:
elif [ x"$STACHE_COMMAND" = x'status' ]; then
	if [ x"$2" = x'--terse' ]; then
		STACHE_STATUS_TERSE=1; export STACHE_STATUS_TERSE
		shift
	fi
	STACHE_REPO_NAME=$2; export STACHE_REPO_NAME
elif [ -n "$2" ]; then
	STACHE_COMMAND='run'; export STACHE_COMMAND
	STACHE_REPO_NAME=$1; export STACHE_REPO_NAME
	GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
	shift 1
	set -- "@GIT@" "$@"
elif [ -n "$STACHE_COMMAND" ]; then
	STACHE_COMMAND='enter'; export STACHE_COMMAND
	STACHE_REPO_NAME=$1; export STACHE_REPO_NAME
	GIT_DIR=$STACHE_REPO_D/$STACHE_REPO_NAME.stache/$STACHE_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
else
	# $1 is empty
	help && exit 1
fi

# Did we receive a directory instead of a name?
# Mangle the input to fit normal operation.
if echo "$STACHE_REPO_NAME" | @GREP@ -q '/'; then
	GIT_DIR=$STACHE_REPO_NAME; export GIT_DIR
	STACHE_REPO_NAME=$(basename "$STACHE_REPO_NAME" .git); export STACHE_REPO_NAME
fi

check_dir() {
	check_directory="$1"
	if [ ! -d "$check_directory" ]; then
		if [ -e "$check_directory" ]; then
			fatal "'$check_directory' exists but is not a directory" 13
		else
			verbose "attempting to create '$check_directory'"
			mkdir -p "$check_directory" || fatal "could not create '$check_directory'" 50
		fi
	fi
}

check_dir "$STACHE_REPO_D"

# Seed the shared fallback ignore file so `git add .` in a stache repo is safe
# out of the box (its working tree is all of $HOME). Ignore everything; use
# `stache <repo> add -f <path>` to track a new file, or `stache write-gitignore
# <repo>` for a curated per-repo list.
if [ ! "x$STACHE_GITIGNORE" = 'xnone' ] && [ ! -e "$STACHE_GITIGNORE_FILE" ]; then
	printf '# stache: ignore everything by default; `stache <repo> add -f <path>` to track a file\n*\n' \
		> "$STACHE_GITIGNORE_FILE" 2> /dev/null || true
fi

verbose "$STACHE_COMMAND begin"
STACHE_COMMAND=$(echo "$STACHE_COMMAND" | @SED@ 's/-/_/g'); export STACHE_COMMAND

# Source repo-specific configuration file, if present: <repo>.stache/config
# shellcheck source=/dev/null
[ -r "$STACHE_REPO_D/$STACHE_REPO_NAME.stache/config" ] \
	&& . "$STACHE_REPO_D/$STACHE_REPO_NAME.stache/config"

# source overlay functions
for overlay in "$STACHE_OVERLAY_D/$STACHE_COMMAND"* "$STACHE_OVERLAY_D/$STACHE_REPO_NAME.$STACHE_COMMAND"*; do
	[ -r "$overlay" ] || continue
	info "sourcing '$overlay'"
	# shellcheck source=/dev/null
	. "$overlay"
done

hook pre-command
$STACHE_COMMAND "$@"
hook post-command

# Keep $STACHE_REPOS current after any command that can change the repo set
# or a repo's remote. Regenerated in place; only rewritten if it changed.
case $STACHE_COMMAND in
	init|clone|delete|rename|upgrade|restore) write_repos_file ;;
esac

verbose "$STACHE_COMMAND end, exiting"
exit $STACHE_COMMAND_RETURN_CODE

# Local Variables:
# mode:shell-script
# sh-shell:sh
# End:
# vim: ft=sh:
